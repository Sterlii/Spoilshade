{
  "name": "spoilshade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Hide the spoilers. Keep the surprise.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.mjs",
    "test:browser": "node tests/browser.mjs",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --warnings-as-errors",
    "verify:release": "node --test tests/release.mjs",
    "assets": "python3 scripts/assets.py"
  },
  "devDependencies": {
    "jsdom": "31.0.1",
    "playwright": "1.65.1",
    "selenium-webdriver": "4.52.0",
    "web-ext": "10.8.0"
  }
}
